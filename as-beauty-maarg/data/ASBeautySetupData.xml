            settingTypeEnumId="RATE_SHOPPING" 
            settingValue="Y"/>

        <org.apache.ofbiz.product.store.ProductStoreCatalog 
            prodCatalogId="DUMMY_CATALOG" 
            fromDate="2026-01-01 12:00:00.000" 
            sequenceNum="1"/>
    </org.apache.ofbiz.product.store.ProductStore>

    <!-- 5. SHOPIFY SHOPS (Mapped to Single ProductStore) -->
